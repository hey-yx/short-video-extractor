{
  "name": "short-video-extractor",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun build ./src/index.ts --compile --outfile dist/sve",
    "format": "prettier --write src tests"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "elysia": "^1.2.0",
    "@elysiajs/cors": "^1.2.0",
    "lru-cache": "^11.0.0",
    "pino": "^9.5.0",
    "puppeteer": "^24.1.0"
  }
}
