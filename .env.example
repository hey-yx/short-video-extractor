# 服务端口
PORT=7777
# 浏览器兜底总开关（默认开；off = 全平台纯 HTTP，风控如实 503，免 Chrome 常驻内存）
# BROWSER_FALLBACK=off
# 可选中转签名密钥（P4 /media 用；不配则 /media 返回 501）
# PROXY_SECRET=change-me
# 可选 API Key（逗号分隔；不配则不鉴权）
# API_KEYS=
# Instagram 匿名 GraphQL doc_id（必配才能解析 IG 链接；IG 发版会轮换，跟踪 instaloader/gallery-dl 更新）
# IG_GRAPHQL_DOC_ID=27128499623469141
# 抖音 L2 签名通道身份（uifid 一次性用浏览器铸造后长期复用，步骤见 docs/research/01 §12；不配则 L1 风控时直落浏览器兜底）
# DOUYIN_UIFID=（不配时有浏览器就自动铸造并池化管理；显式配置=固定用这个身份，失效要手动重铸）
# 可选：与 uifid 同一次铸造带出的 ttwid；缺省自动注册
# DOUYIN_TTWID=
# 海外平台出站代理兜底（不配则直连；中国云服务器部署 YouTube/IG 必须走代理；只认 http:// 串）
# HTTPS_PROXY=http://user:pass@proxy-host:port
# 按平台覆盖（可选；优先于 HTTPS_PROXY，设了哪个平台哪个平台走）
# PROXY_INSTAGRAM=
# PROXY_YOUTUBE=
